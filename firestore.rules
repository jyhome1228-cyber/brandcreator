rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Administrator approval is granted manually in the Firebase console.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Personal data must remain private. Do not allow unauthenticated reads.
    match /betaTesters/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /usageEvents/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // This collection contains aggregated daily counters only:
    // day, visits, unique. There is no personally identifiable visit record.
    function anonymousVisit() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function validVisitData(day) {
      return request.resource.data.keys().hasOnly(['day', 'visits', 'unique'])
        && request.resource.data.keys().hasAll(['day', 'visits', 'unique'])
        && request.resource.data.day is string
        && request.resource.data.day == day
        && day.size() == 10
        && request.resource.data.visits is int
        && request.resource.data.unique is int
        && request.resource.data.visits >= 1
        && request.resource.data.unique >= 0
        && request.resource.data.unique <= request.resource.data.visits;
    }
    match /visitDaily/{day} {
      allow get, list: if true;
      allow create: if anonymousVisit()
        && validVisitData(day)
        && request.resource.data.visits == 1
        && request.resource.data.unique <= 1;
      allow update: if anonymousVisit()
        && validVisitData(day)
        && resource.data.day == day
        && request.resource.data.visits == resource.data.visits + 1
        && request.resource.data.unique >= resource.data.unique
        && request.resource.data.unique <= resource.data.unique + 1;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
